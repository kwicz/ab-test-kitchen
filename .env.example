# Copy to .env for local overrides. Nothing here is required for the demo.

# Postgres connection. Unset = embedded PGlite in ./.pglite (local dev).
# On Railway, reference the Postgres service: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# "off" hides the Reset demo button and endpoint (use once real data is in).
DEMO_MODE=

# --- Live connectors: set every variable for a platform to switch it from demo to live ---

# Optimizely: personal access token. Optional comma list of project IDs.
OPTIMIZELY_API_TOKEN=
OPTIMIZELY_PROJECT_IDS=

# Convert: API secret key (Bearer) and account ID. Optional comma list of project IDs.
CONVERT_API_KEY=
CONVERT_ACCOUNT_ID=
CONVERT_PROJECT_IDS=

# VWO: API token and comma list of account IDs (one per client workspace).
VWO_API_TOKEN=
VWO_ACCOUNT_IDS=

# Intelligems: per-store access token and the client name to file its tests under.
INTELLIGEMS_API_KEY=
INTELLIGEMS_CLIENT_NAME=

# Shoplift and Shopify Rollouts have no public results API: import their CSV exports in the Pantry.
